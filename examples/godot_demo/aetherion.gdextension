[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://aetherion.dll"
windows.release.x86_64 = "res://aetherion.dll"
linux.debug.x86_64 = "res://libaetherion.so"
linux.release.x86_64 = "res://libaetherion.so"
macos.debug = "res://libaetherion.dylib"
macos.release = "res://libaetherion.dylib"
